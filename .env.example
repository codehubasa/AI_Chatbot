# Server Port (default 5000)
PORT=5000

# OPTION 1: Groq API Key (100% FREE Tier - Meta Llama 3.3 70B & 8B, No Credit Card Required)
# Get your free key instantly at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_free_key_here

# OPTION 2: OpenAI API Key (Paid Tier - GPT-4o-mini)
# Get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Model Selection (defaults automatically to llama-3.3-70b-versatile for Groq or gpt-4o-mini for OpenAI)
OPENAI_MODEL=gpt-4o-mini
